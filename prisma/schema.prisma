datasource db {
  provider = "sqlite"
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["driverAdapters"]
}

model User {
  id         Int      @id @default(autoincrement())
  name       String?
  title     String?
  email      String   @unique
  password   String
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
}